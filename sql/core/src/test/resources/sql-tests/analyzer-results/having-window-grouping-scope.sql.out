-- !query
SELECT k + 1.5 + 10 AS k, count(*) OVER () AS n
FROM VALUES (1), (2) AS t(k)
GROUP BY k + 1.5 HAVING k + 1.5 >= 3 ORDER BY 1
-- !query analysis
Sort [k#x ASC NULLS FIRST], true
+- Project [k#x, n#xL]
   +- Project [k#x, n#xL, n#xL]
      +- Window [count(1) windowspecdefinition(specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS n#xL]
         +- Project [k#x]
            +- Filter ((k + 1.5)#x >= cast(cast(3 as decimal(1,0)) as decimal(12,1)))
               +- Aggregate [(cast(k#x as decimal(10,0)) + 1.5)], [((cast(k#x as decimal(10,0)) + 1.5) + cast(10 as decimal(2,0))) AS k#x, (cast(k#x as decimal(10,0)) + 1.5) AS (k + 1.5)#x]
                  +- SubqueryAlias t
                     +- LocalRelation [k#x]


