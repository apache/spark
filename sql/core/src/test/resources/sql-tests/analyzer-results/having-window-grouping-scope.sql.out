   +- Project [_gen_input_0#x, k#x, n#xL]
      +- Project [_gen_input_0#x, k#x, _w0#x, n#xL, n#xL]
         +- Window [sum(_w0#x) windowspecdefinition(specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS n#xL]
            +- Project [_gen_input_0#x, k#x, _w0#x]
               +- Project [_gen_input_0#x, k#x, _w0#xL, _w0#x, _w0#x]
                  +- Window [rank(_w0#xL) windowspecdefinition(_w0#xL ASC NULLS FIRST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS _w0#x], [_w0#xL ASC NULLS FIRST]
                     +- Filter (k#x = 2)
                        +- Aggregate [k#x], [array(k#x) AS _gen_input_0#x, k#x, sum(v#x) AS _w0#xL]
                           +- SubqueryAlias t
                              +- LocalRelation [k#x, v#x]


-- !query
SELECT k, sum(v) AS s, count(*) OVER () AS n
FROM VALUES (1, 10), (2, 20) AS t(k, v)
GROUP BY GROUPING SETS ((k), ())
HAVING sum(v) > 0 AND grouping_id() = 0 ORDER BY grouping_id(), k
-- !query analysis
Project [k#x, s#xL, n#xL]
+- Sort [spark_grouping_id#xL ASC NULLS FIRST, k#x ASC NULLS FIRST], true
   +- Project [k#x, s#xL, n#xL, spark_grouping_id#xL]
      +- Project [k#x, s#xL, n#xL, n#xL, spark_grouping_id#xL]
         +- Window [count(1) windowspecdefinition(specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS n#xL]
            +- Filter ((s#xL > cast(0 as bigint)) AND (spark_grouping_id#xL = cast(0 as bigint)))
               +- Aggregate [k#x, spark_grouping_id#xL], [k#x, sum(v#x) AS s#xL, spark_grouping_id#xL]
                  +- Expand [[k#x, v#x, k#x, 0], [k#x, v#x, null, 1]], [k#x, v#x, k#x, spark_grouping_id#xL]
                     +- Project [k#x, v#x, k#x AS k#x]
                        +- SubqueryAlias t
                           +- LocalRelation [k#x, v#x]


