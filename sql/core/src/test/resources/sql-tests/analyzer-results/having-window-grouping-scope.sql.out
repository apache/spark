-- !query
SELECT concat(lower(name), '!') AS name, count(*) OVER () AS n
FROM VALUES ('Bob'), ('bob'), ('Al') AS t(name)
GROUP BY lower(name) HAVING (SELECT lower(name)) = 'bob'
-- !query analysis
Project [name#x, n#xL]
+- Project [name#x, n#xL, n#xL]
   +- Window [count(1) windowspecdefinition(specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS n#xL]
      +- Project [name#x]
         +- Filter (scalar-subquery#x [lower(name)#x] = bob)
            :  +- Project [outer(lower(name)#x) AS lower(outer(t.name))#x]
            :     +- OneRowRelation
            +- Aggregate [lower(name#x)], [concat(lower(name#x), !) AS name#x, lower(name#x) AS lower(name)#x]
               +- SubqueryAlias t
                  +- LocalRelation [name#x]


-- !query
SELECT max(name) AS name, count(*) OVER () AS n
FROM VALUES (1, 'Bob'), (1, 'bob'), (2, 'Al') AS t(k, name)
GROUP BY k HAVING lower(name) = 'bob'
-- !query analysis
Project [name#x, n#xL]
+- Project [name#x, n#xL, n#xL]
   +- Window [count(1) windowspecdefinition(specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS n#xL]
      +- Project [name#x]
         +- Filter (lower(name#x) = bob)
            +- Aggregate [k#x], [max(name#x) AS name#x, k#x AS k#x]
               +- SubqueryAlias t
                  +- LocalRelation [k#x, name#x]


-- !query
SELECT (k + 1) + 10 AS k, count(*) OVER () AS n
FROM VALUES (1), (2) AS t(k)
GROUP BY ROLLUP(k + 1) HAVING k + 1 = 3 ORDER BY `(k + 1)`
-- !query analysis
Project [k#x, n#xL]
+- Sort [(k + 1)#x ASC NULLS FIRST], true
   +- Project [k#x, n#xL, (k + 1)#x]
      +- Project [k#x, n#xL, n#xL, (k + 1)#x]
         +- Window [count(1) windowspecdefinition(specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS n#xL]
            +- Project [k#x, (k + 1)#x]
               +- Project [k#x, (k + 1)#x, spark_grouping_id#xL, (k + 1)#x]
                  +- Filter ((k + 1)#x = 3)
                     +- Aggregate [(k + 1)#x, spark_grouping_id#xL], [((k + 1)#x + 10) AS k#x, (k + 1)#x AS (k + 1)#x, spark_grouping_id#xL AS spark_grouping_id#xL, (k + 1)#x, (k + 1)#x]
                        +- Expand [[k#x, (k + 1)#x, 0], [k#x, null, 1]], [k#x, (k + 1)#x, spark_grouping_id#xL]
                           +- Project [k#x, (k#x + 1) AS (k + 1)#x]
                              +- SubqueryAlias t
                                 +- LocalRelation [k#x]


