      +- Project [id#xL, grp#xL, value#xL, row_number() OVER (ORDER BY count(1) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, sum(input.value) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x]
         +- Project [id#xL, grp#xL, value#xL, _w0#xL, _w1#xL, row_number() OVER (ORDER BY count(1) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, sum(input.value) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x, row_number() OVER (ORDER BY count(1) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, sum(input.value) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x]
            +- Window [row_number() windowspecdefinition(_w0#xL DESC NULLS LAST, _w1#xL DESC NULLS LAST, id#xL ASC NULLS FIRST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS row_number() OVER (ORDER BY count(1) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, sum(input.value) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) DESC NULLS LAST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x], [_w0#xL DESC NULLS LAST, _w1#xL DESC NULLS LAST, id#xL ASC NULLS FIRST]
               +- Project [id#xL, grp#xL, value#xL, _w0#xL, _w1#xL]
                  +- Project [id#xL, grp#xL, value#xL, _w0#xL, _w1#xL, _w0#xL, _w1#xL]
                     +- Window [count(1) windowspecdefinition(grp#xL, specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS _w0#xL, sum(value#xL) windowspecdefinition(grp#xL, specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS _w1#xL], [grp#xL]
                        +- Project [id#xL, grp#xL, value#xL]
                           +- Project [id#xL, grp#xL, value#xL]
                              +- SubqueryAlias input
                                 +- LocalRelation [id#xL, grp#xL, value#xL]


-- !query
SELECT id, grp
FROM VALUES
  (0L, 0L, 10L), (1L, 0L, 20L), (2L, 1L, 30L),
  (3L, 2L, 40L), (4L, 2L, 50L), (5L, 2L, 60L)
  AS input(id, grp, value)
QUALIFY ROW_NUMBER() OVER (
  ORDER BY SUM(ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id))
    OVER (PARTITION BY grp), id
) = 1
ORDER BY id
-- !query analysis
Sort [id#xL ASC NULLS FIRST], true
+- Project [id#xL, grp#xL]
   +- Filter (row_number() OVER (ORDER BY sum(row_number() OVER (PARTITION BY input.grp ORDER BY input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) ASC NULLS FIRST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x = 1)
      +- Project [id#xL, grp#xL, row_number() OVER (ORDER BY sum(row_number() OVER (PARTITION BY input.grp ORDER BY input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) ASC NULLS FIRST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x]
         +- Project [id#xL, grp#xL, _w0#xL, row_number() OVER (ORDER BY sum(row_number() OVER (PARTITION BY input.grp ORDER BY input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) ASC NULLS FIRST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x, row_number() OVER (ORDER BY sum(row_number() OVER (PARTITION BY input.grp ORDER BY input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) ASC NULLS FIRST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x]
            +- Window [row_number() windowspecdefinition(_w0#xL ASC NULLS FIRST, id#xL ASC NULLS FIRST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS row_number() OVER (ORDER BY sum(row_number() OVER (PARTITION BY input.grp ORDER BY input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) OVER (PARTITION BY input.grp ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) ASC NULLS FIRST, input.id ASC NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)#x], [_w0#xL ASC NULLS FIRST, id#xL ASC NULLS FIRST]
               +- Project [id#xL, grp#xL, _w0#xL]
                  +- Project [id#xL, grp#xL, _w0#x, _w0#xL, _w0#xL]
                     +- Window [sum(_w0#x) windowspecdefinition(grp#xL, specifiedwindowframe(RowFrame, unboundedpreceding$(), unboundedfollowing$())) AS _w0#xL], [grp#xL]
                        +- Project [id#xL, grp#xL, _w0#x]
                           +- Project [id#xL, grp#xL, _w0#x, _w0#x]
                              +- Window [row_number() windowspecdefinition(grp#xL, id#xL ASC NULLS FIRST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS _w0#x], [grp#xL], [id#xL ASC NULLS FIRST]
                                 +- Project [id#xL, grp#xL]
                                    +- Project [id#xL, grp#xL]
                                       +- SubqueryAlias input
                                          +- LocalRelation [id#xL, grp#xL, value#xL]


-- !query
SELECT lead(COL1) OVER (ORDER BY COL1) AS flag, * FROM t1
-- !query analysis
Project [flag#x, col1#x, col2#x]
+- Project [col1#x, col2#x, flag#x, flag#x]
   +- Window [lead(COL1#x, 1, null) windowspecdefinition(COL1#x ASC NULLS FIRST, specifiedwindowframe(RowFrame, 1, 1)) AS flag#x], [COL1#x ASC NULLS FIRST]
      +- Project [col1#x, col2#x]
         +- SubqueryAlias spark_catalog.default.t1
            +- Relation spark_catalog.default.t1[col1#x,col2#x] parquet


