-- !query
SELECT COUNT(DISTINCT named_struct('m', m, 'n', n))
FROM VALUES
  (map('a', 1, 'b', 2), map('x', 1, 'y', 2)),
  (map('b', 2, 'a', 1), map('y', 2, 'x', 1))
AS grouped_distinct_map_data(m, n)
GROUP BY m
-- !query analysis
Aggregate [m#x], [count(distinct named_struct(m, m#x, n, n#x)) AS count(DISTINCT named_struct(m, m, n, n))#xL]
+- SubqueryAlias grouped_distinct_map_data
   +- LocalRelation [m#x, n#x]
