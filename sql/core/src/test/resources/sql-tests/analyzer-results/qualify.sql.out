SetCommand (spark.sql.legacy.qualifyPreferSelectAlias,Some(true))


-- !query
SELECT id, ROW_NUMBER() OVER (ORDER BY score DESC) AS rn
FROM VALUES (1, 30, 0), (2, 20, 0), (3, 10, 1) AS t(id, score, rn)
QUALIFY rn = 1
ORDER BY id
-- !query analysis
Sort [id#x ASC NULLS FIRST], true
+- Filter (rn#x = 1)
   +- Project [id#x, rn#x]
      +- Project [id#x, score#x, rn#x, rn#x]
         +- Window [row_number() windowspecdefinition(score#x DESC NULLS LAST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS rn#x], [score#x DESC NULLS LAST]
            +- Project [id#x, score#x]
               +- SubqueryAlias t
                  +- LocalRelation [id#x, score#x, rn#x]


-- !query
RESET spark.sql.legacy.qualifyPreferSelectAlias
-- !query analysis
ResetCommand spark.sql.legacy.qualifyPreferSelectAlias


-- !query
SELECT id, rn, RANK() OVER (ORDER BY id) AS rank
FROM (
  SELECT id, ROW_NUMBER() OVER (ORDER BY score DESC) AS rn
  FROM VALUES (1, 30), (2, 20), (3, 10) AS t(id, score)
) s
QUALIFY rn = 1
-- !query analysis
Filter (rn#x = 1)
+- Project [id#x, rn#x, rank#x]
   +- Project [id#x, rn#x, rank#x, rank#x]
      +- Window [rank(id#x) windowspecdefinition(id#x ASC NULLS FIRST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS rank#x], [id#x ASC NULLS FIRST]
         +- Project [id#x, rn#x]
            +- SubqueryAlias s
               +- Project [id#x, rn#x]
                  +- Project [id#x, score#x, rn#x, rn#x]
                     +- Window [row_number() windowspecdefinition(score#x DESC NULLS LAST, specifiedwindowframe(RowFrame, unboundedpreceding$(), currentrow$())) AS rn#x], [score#x DESC NULLS LAST]
                        +- Project [id#x, score#x]
                           +- SubqueryAlias t
                              +- LocalRelation [id#x, score#x]
