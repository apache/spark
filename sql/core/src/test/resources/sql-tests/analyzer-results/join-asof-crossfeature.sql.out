-- !query
SELECT t0.trade_time, t0.symbol,
  t0.quantity IN (
    SELECT t.quantity
    FROM (SELECT * FROM trades t WHERE t.symbol = t0.symbol) t
    ASOF JOIN quotes q
      MATCH_CONDITION (t.trade_time >= q.quote_time)
      ON t.symbol = q.symbol) AS has_quote
FROM trades t0
ORDER BY t0.trade_time
