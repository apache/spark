  (SELECT sum(q.bid_price)
   FROM trades t
   ASOF JOIN (SELECT * FROM quotes q WHERE o.max_bid IS NULL OR q.bid_price <= o.max_bid) q
     MATCH_CONDITION (t.trade_time >= q.quote_time)
     ON t.symbol = q.symbol) AS total_bid
