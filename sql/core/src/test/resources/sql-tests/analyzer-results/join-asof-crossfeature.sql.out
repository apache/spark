-- !query
SELECT o.lag,
  (SELECT count(*)
   FROM trades t ASOF JOIN quotes q
     MATCH_CONDITION (t.trade_time >= q.quote_time + o.lag)
     ON t.symbol = q.symbol) AS matched
FROM VALUES (INTERVAL '1' SECOND) AS o(lag)
