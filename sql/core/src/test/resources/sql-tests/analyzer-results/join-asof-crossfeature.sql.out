-- !query
SELECT o.max_bid
FROM VALUES (100.00), (180.17), (500.00) AS o(max_bid)
WHERE EXISTS (
  SELECT 1
  FROM trades t
  ASOF JOIN (SELECT * FROM quotes q WHERE q.bid_price <= o.max_bid) q
    MATCH_CONDITION (t.trade_time >= q.quote_time)
    ON t.symbol = q.symbol
  WHERE q.bid_price = 180.15)
ORDER BY o.max_bid
