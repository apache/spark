     WHERE should_update(id);
   ELSE
     DELETE FROM delete_target
     WHERE id IN (SELECT id FROM delete_source WHERE expired(ts));
   END IF;

   FOR row AS
     SELECT id FROM loop_source WHERE ready(id)
