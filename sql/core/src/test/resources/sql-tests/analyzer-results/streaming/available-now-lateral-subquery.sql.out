-- !query
WITH batch_output AS (
  SELECT events.event_id, events.amount,
    events.amount + adjustments.adjustment AS adjusted_amount
  FROM streaming_sql_golden_lateral_events AS events,
  LATERAL (
    SELECT adjustment
