FROM (
  SELECT store, named_struct('lo', jan, 'hi', feb) AS h1, named_struct('lo', mar, 'hi', apr) AS h2
  FROM monthlySales
)
UNPIVOT (b FOR half IN (h1, h2))
ORDER BY store, half
-- !query analysis
Sort [store#x ASC NULLS FIRST, half#x ASC NULLS FIRST], true
+- Project [store#x, half#x, b#x.lo AS lo#x, b#x.hi AS hi#x, isnull(b#x.hi) AS hi_is_null#x]
   +- Filter isnotnull(coalesce(b#x))
      +- Expand [[store#x, h1, cast(h1#x as struct<lo:int,hi:int>)], [store#x, h2, h2#x]], [store#x, half#x, b#x]
         +- SubqueryAlias __auto_generated_subquery_name
            +- Project [store#x, named_struct(lo, jan#x, hi, feb#x) AS h1#x, named_struct(lo, mar#x, hi, apr#x) AS h2#x]
               +- SubqueryAlias monthlysales
                  +- View (`monthlySales`, [store#x, jan#x, feb#x, mar#x, apr#x])
                     +- Project [cast(store#x as string) AS store#x, cast(jan#x as int) AS jan#x, cast(feb#x as int) AS feb#x, cast(mar#x as int) AS mar#x, cast(apr#x as int) AS apr#x]
