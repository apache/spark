-- !query
WITH batch_output AS (
  FROM streaming_sql_golden_pipe_source
  |> WHERE amount >= 5
  |> EXTEND amount * 2 AS doubled_amount
  |> SELECT id, upper(category) AS category, doubled_amount
),
streaming_output AS (
