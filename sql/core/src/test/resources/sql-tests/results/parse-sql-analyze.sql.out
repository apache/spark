'BEGIN
   DECLARE n INT DEFAULT 0;
   CREATE TABLE parse_sql_script_t (id INT, name STRING);
   outer_blk: BEGIN
     DECLARE n STRING DEFAULT ''x'';
     INSERT INTO parse_sql_script_t VALUES (1, n);
   END outer_blk;
   FOR r AS SELECT id, name FROM parse_sql_script_t AS s DO
     SET n = n + r.id;
