-- !query
SELECT symbol, metric, val
FROM (
  SELECT t.symbol, q.bid_price, t.quantity
  FROM trades t ASOF JOIN quotes q
    MATCH_CONDITION (t.trade_time >= q.quote_time)
    ON t.symbol = q.symbol
) src
UNPIVOT (val FOR metric IN (bid_price, quantity))
ORDER BY symbol, metric
-- !query schema
struct<symbol:string,metric:string,val:decimal(12,2)>
-- !query output
AAPL	bid_price	180.10
AAPL	bid_price	180.20
AAPL	quantity	100.00
AAPL	quantity	200.00
MSFT	bid_price	420.50
MSFT	quantity	50.00


-- !query
SELECT t.trade_time, t.symbol, l.doubled
FROM trades t ASOF JOIN quotes q
  MATCH_CONDITION (t.trade_time >= q.quote_time)
  ON t.symbol = q.symbol,
LATERAL (SELECT q.bid_price * 2 AS doubled) l
ORDER BY t.trade_time
-- !query schema
struct<trade_time:timestamp,symbol:string,doubled:decimal(7,2)>
