   ASOF JOIN quotes q
     MATCH_CONDITION (t.trade_time >= q.quote_time)
     ON t.symbol = q.symbol) AS max_bid
FROM VALUES ('AAPL'), ('GOOG'), ('MSFT') AS s(symbol)
ORDER BY s.symbol
