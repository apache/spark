"""
Validate a built Spark distribution.
"""

import argparse
import os
import re
import subprocess
import sys
import tarfile
import tempfile
from contextlib import contextmanager
from pathlib import Path


REQUIRED_DIST_PATHS = [
    "bin",
    "jars",
    "python/lib/pyspark.zip",
    "sbin/start-master.sh",
    "sbin/stop-master.sh",
    "sbin/start-worker.sh",
    "sbin/stop-worker.sh",
    "sbin/start-history-server.sh",
    "sbin/stop-history-server.sh",
    "LICENSE",
    "NOTICE",
    "RELEASE",
]

SMOKE_TESTS = [
    ("bin/spark-submit", "--master", "local[1]", "examples/src/main/python/pi.py", "1"),
    ("sbin/start-thriftserver.sh", "--help"),
    ("sbin/start-connect-server.sh", "--help"),
]

SMOKE_TEST_TIMEOUT = 120

# Scripts that must have SPARK_CONNECT_MODE set in the Connect distribution.
CONNECT_MODE_SCRIPTS = [
    "bin/pyspark",
    "bin/spark-shell",
    "bin/spark-submit",
]


@contextmanager
def resolve_distribution(dist_input: Path):
    """Yield a directory path to a distribution, unpacking a .tgz to a temp dir if needed."""
    if dist_input.is_dir():
        yield dist_input.resolve()
    elif dist_input.is_file():
        with tempfile.TemporaryDirectory() as tmp:
            work_dir = Path(tmp)
            print(f"Unpacking {dist_input} into {work_dir}")
            with tarfile.open(dist_input) as tf:
                tf.extractall(work_dir, filter="data")
            top_level = list(work_dir.iterdir())
            if len(top_level) != 1:
                print(
                    f"Expected one top-level entry, got: {top_level}",
                    file=sys.stderr,
                )
                sys.exit(1)
            yield top_level[0]
    else:
        print(f"Not found: {dist_input}", file=sys.stderr)
        sys.exit(1)


def check_distribution(spark_dist: Path) -> list[str]:
    errors = []
    print(f"Testing distribution at: {spark_dist}\n")

    print("Checking distribution structure...", end=" ", flush=True)
    missing = [p for p in REQUIRED_DIST_PATHS if not (spark_dist / p).exists()]
    for p in missing:
        errors.append(f"MISSING: {p}")
    if missing:
        print("FAILED")
        for p in missing:
            print(f"  MISSING: {p}")
    else:
        print("OK")

    # Isolate from the caller's Spark/Python environment so a source checkout
    # cannot mask a broken distribution (e.g. SPARK-58428 / missing pyspark.zip).
    env = os.environ.copy()
    env["SPARK_HOME"] = str(spark_dist)
    env["SPARK_CONNECT_MODE"] = "0"
    env.pop("PYTHONPATH", None)
    env.pop("SPARK_PREPEND_CLASSES", None)

    for rel_path, *args in SMOKE_TESTS:
        label = " ".join([rel_path, *args])
        print(f"Checking {label}...", end=" ", flush=True)
        try:
            result = subprocess.run(
                [str(spark_dist / rel_path), *args],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                timeout=SMOKE_TEST_TIMEOUT,
                cwd=spark_dist,
                env=env,
            )
        except subprocess.TimeoutExpired:
            print("FAILED")
            errors.append(f"{label}: timed out after {SMOKE_TEST_TIMEOUT}s")
            continue
        except OSError as e:
            print("FAILED")
            errors.append(f"{label}: {e}")
            continue
        if result.returncode != 0:
            print("FAILED")
            for line in result.stdout.splitlines():
                print(f"  {line}")
            errors.append(f"{label}: exited {result.returncode}")
        else:
            print("OK")

    return errors


def check_tar_has_license_notice(tar_path: Path, label: str) -> list[str]:
    """
    Verify LICENSE and NOTICE are at the package root per ASF policy.
    See: https://www.apache.org/legal/release-policy.html#licensing-documentation
    """
    errors = []
    print(f"Checking {label} for LICENSE and NOTICE...", end=" ", flush=True)
    with tarfile.open(tar_path) as tf:
        names = tf.getnames()
    for required in ["LICENSE", "NOTICE"]:
        pattern = re.compile(r"^[^/]+/" + re.escape(required) + r"$")
        if not any(pattern.match(name) for name in names):
            errors.append(f"{tar_path.name}: missing {required} at the package root")
    if errors:
        print("FAILED")
        for e in errors:
            print(f"  {e}")
    else:
        print("OK")
    return errors


def check_connect_scripts(spark_dist: Path) -> list[str]:
    """Verify the Connect distribution has SPARK_CONNECT_MODE set in key scripts."""
    errors = []
    print("Checking Connect environment variables...", end=" ", flush=True)
    for script in CONNECT_MODE_SCRIPTS:
        path = spark_dist / script
        if not path.exists():
            errors.append(f"{script}: not found in Connect distribution")
            continue
        content = path.read_text()
        if "SPARK_CONNECT_MODE" not in content:
            errors.append(f"{script}: missing SPARK_CONNECT_MODE")
    if errors:
        print("FAILED")
        for e in errors:
            print(f"  {e}")
    else:
        print("OK")
    return errors


def main():
    parser = argparse.ArgumentParser(
        description="Basic validation and smoke tests for a built Spark distribution.",
    )
    parser.add_argument(
        "distribution",
        type=Path,
        help="Path to a distribution directory or .tgz",
    )
    parser.add_argument(
        "--pip",
        metavar="DIR",
        type=Path,
        help="Directory containing PySpark sdists (pyspark*.tar.gz) to validate",
    )
    parser.add_argument(
        "--r",
        metavar="FILE",
        type=Path,
        help="SparkR source package (.tar.gz) to validate",
    )
    parser.add_argument(
        "--connect",
        metavar="FILE",
        type=Path,
        help="Connect-enabled distribution .tgz to validate",
    )
    args = parser.parse_args()

    errors = []

    with resolve_distribution(args.distribution) as spark_dist:
        errors.extend(check_distribution(spark_dist))

    if args.connect:
        with resolve_distribution(args.connect) as connect_dist:
            errors.extend(check_distribution(connect_dist))
            errors.extend(check_connect_scripts(connect_dist))

    if args.pip:
        pip_dist = args.pip
        sdists = sorted(pip_dist.glob("pyspark*.tar.gz"))
        if not sdists:
            errors.append(f"no pyspark*.tar.gz found in {pip_dist}")
        else:
            for sdist in sdists:
                errors.extend(check_tar_has_license_notice(sdist, sdist.name))

    if args.r:
        errors.extend(check_tar_has_license_notice(args.r, "SparkR"))

    if errors:
        print(f"\n{len(errors)} check(s) failed:", file=sys.stderr)
        for e in errors:
            print(f"  {e}", file=sys.stderr)
        sys.exit(1)

    print("All distribution validation checks passed.")


if __name__ == "__main__":
    main()
