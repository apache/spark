+  private def causeChainContains(t: Throwable, needle: String): Boolean = {
+    var cur = t
+    while (cur != null) {
+      if (cur.getMessage != null && cur.getMessage.contains(needle)) return true
+      cur = cur.getCause
+    }
+    false
+  }
